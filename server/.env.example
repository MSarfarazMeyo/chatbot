# --- Server ---
PORT=3001

# --- LLM provider (any OpenAI-compatible API) ---
# Base URL (must end with .../v1 for most providers)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Optional
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
# Default system prompt used when the client doesn't send one
LLM_SYSTEM_PROMPT=You are a helpful, concise assistant.

# --- Client ---
# Comma-separated origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
